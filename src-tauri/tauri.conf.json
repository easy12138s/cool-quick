{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist",
    "withGlobalTauri": false
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "window": {
        "all": true
      },
      "globalShortcut": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.coolquick.app",
      "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
      "category": "Productivity"
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:1420; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:;"
    },
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    },
    "windows": [
      {
        "label": "main",
        "title": "CoolQuick",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "center": true,
        "visible": false,
        "url": "/"
      },
      {
        "label": "floating",
        "title": "CoolQuick Floating",
        "width": 56,
        "height": 56,
        "x": -60,
        "y": 300,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "visible": true,
        "url": "/?window=floating"
      },
      {
        "label": "drawer",
        "title": "CoolQuick Drawer",
        "width": 380,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "visible": false,
        "url": "/?window=drawer"
      },
      {
        "label": "popup",
        "title": "CoolQuick Popup",
        "width": 380,
        "height": 280,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "visible": false,
        "url": "/?window=popup"
      }
    ]
  }
}

{
  "productName": "CoolQuick",
  "version": "0.1.0",
  "identifier": "com.coolquick.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "floating",
        "title": "CoolQuick",
        "width": 60,
        "height": 60,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "transparent": true,
        "center": false,
        "x": 100,
        "y": 100
      },
      {
        "label": "drawer",
        "title": "CoolQuick Notes",
        "width": 350,
        "height": 500,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "transparent": true,
        "center": false
      },
      {
        "label": "popup",
        "title": "Clip Detected",
        "width": 360,
        "height": 200,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "transparent": true,
        "center": false
      },
      {
        "label": "settings",
        "title": "CoolQuick Settings",
        "width": 700,
        "height": 600,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Smart clipboard manager",
    "longDescription": "A smart clipboard manager that automatically detects and organizes your copied content with quick note-taking capabilities.",
    "deb": {
      "depends": []
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "license": "MIT"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
